diff --git a/lua/neotest-nix/discover.lua b/lua/neotest-nix/discover.lua
index 1edb5df..59c1c2a 100644
--- a/lua/neotest-nix/discover.lua
+++ b/lua/neotest-nix/discover.lua
@@ -309,6 +309,7 @@ local function flake_root(start)
 end
 
 ---@type fun(file_path: string): boolean
+local has_nix_test_binding
 local has_nix_unit_assertion
 
 ---@param file_path string
@@ -336,7 +337,8 @@ local function recognized_non_flake_test_file(file_path)
     return false
   end
 
-  return has_nix_unit_assertion(file_path)
+  return has_nix_test_binding(file_path)
+    or has_nix_unit_assertion(file_path)
     or require("neotest-nix.runtests").is_runtests_file(file_path)
 end
 
@@ -384,6 +386,18 @@ function M.root(dir, opts)
   return nil
 end
 
+---@param file_path string
+---@return boolean
+has_nix_test_binding = function(file_path)
+  local content = cache.read_source(file_path)
+  if content == nil then
+    return false
+  end
+
+  local search = strip_nix_comments_and_strings(content)
+  return search:match("%f[%w]test%s*%.") ~= nil
+end
+
 ---@param file_path string
 ---@return boolean
 has_nix_unit_assertion = function(file_path)
@@ -554,6 +568,10 @@ function M.is_test_file(file_path, opts)
     return false
   end
 
+  if has_nix_test_binding(file_path) then
+    return true
+  end
+
   if has_nix_unit_assertion(file_path) then
     return true
   end
